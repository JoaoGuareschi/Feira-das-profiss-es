ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-por-uma-senha-unica-e-longa
APP_ORIGIN=http://localhost:3000
# No Render: remova APP_ORIGIN para usar RENDER_EXTERNAL_URL automaticamente,
# ou defina APP_ORIGIN=https://seu-dominio.com para um domínio personalizado.
# Configure NODE_ENV=production no painel da hospedagem.
NODE_ENV=development
PORT=3000

# Somente depois de adicionar um disco persistente em /var/data no Render:
# DATA_DIR=/var/data
